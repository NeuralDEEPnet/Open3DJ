{
  "brief": "o3dj-envelope-brief/spike-0",
  "id": "c04-bolt-circle-safe",
  "script": "scripts/envelope-spike/corpus/c04-bolt-circle-safe.o3j.js",
  "role": "control",
  "sources": [
    "Seeded envelope control C04: a ring with at most 8 M6 clearance holes on a bolt circle of at least 25 mm radius, so the webs between holes stay above 12 mm. Original test part for the Open3DJ envelope spike, MIT. Units are mm, Z is up."
  ],
  "params": [
    {
      "name": "Bolt circle radius",
      "type": "number",
      "default": 30,
      "min": 25,
      "max": 40,
      "unit": "mm"
    },
    {
      "name": "Holes",
      "type": "number",
      "default": 6,
      "min": 3,
      "max": 8,
      "integer": true
    },
    {
      "name": "Thickness",
      "type": "number",
      "default": 6,
      "min": 4,
      "max": 12,
      "unit": "mm"
    }
  ],
  "gates": [
    {
      "targets": [
        "ring"
      ],
      "build": [
        0,
        0,
        1
      ],
      "build_source": "as modelled"
    }
  ],
  "assertions": [
    {
      "id": "builds",
      "kind": "builds"
    },
    {
      "id": "status",
      "kind": "status",
      "in": [
        "ok"
      ]
    },
    {
      "id": "valid",
      "kind": "valid"
    },
    {
      "id": "one-solid",
      "kind": "count",
      "quantity": "solids",
      "target": "ring",
      "expect": {
        "eq": 1
      }
    },
    {
      "id": "faces",
      "kind": "count",
      "quantity": "faces",
      "target": "ring",
      "expect": {
        "eq": "4 + $Holes"
      }
    },
    {
      "id": "gate-watertight",
      "kind": "gate",
      "gate": "watertight",
      "target": "ring"
    },
    {
      "id": "gate-min-wall",
      "kind": "gate",
      "gate": "min_wall",
      "target": "ring"
    }
  ]
}
