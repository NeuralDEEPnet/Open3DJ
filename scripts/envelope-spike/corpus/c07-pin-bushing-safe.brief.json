{
  "brief": "o3dj-envelope-brief/spike-0",
  "id": "c07-pin-bushing-safe",
  "script": "scripts/envelope-spike/corpus/c07-pin-bushing-safe.o3j.js",
  "role": "control",
  "sources": [
    "Seeded envelope control C07: a pin in a bushing whose bore is always at least 0.2 mm larger than the pin, so the running clearance never drops below 0.1 mm. Two parts. Original test part for the Open3DJ envelope spike, MIT. Units are mm, Z is up."
  ],
  "params": [
    {
      "name": "Bore",
      "type": "number",
      "default": 7,
      "min": 6.8,
      "max": 7.4,
      "unit": "mm"
    },
    {
      "name": "Pin",
      "type": "number",
      "default": 6.4,
      "min": 5.6,
      "max": 6.6,
      "unit": "mm"
    },
    {
      "name": "Length",
      "type": "number",
      "default": 20,
      "min": 12,
      "max": 30,
      "unit": "mm"
    }
  ],
  "gates": [],
  "assertions": [
    {
      "id": "builds",
      "kind": "builds"
    },
    {
      "id": "status",
      "kind": "status",
      "in": [
        "ok"
      ]
    },
    {
      "id": "valid",
      "kind": "valid"
    },
    {
      "id": "occurrences",
      "kind": "count",
      "quantity": "occurrences",
      "expect": {
        "eq": 2
      }
    },
    {
      "id": "no-clash",
      "kind": "fits",
      "fit": "clash",
      "expect": {
        "eq": 0
      }
    },
    {
      "id": "pin-gap",
      "kind": "fits",
      "fit": "clearance",
      "a": "pin",
      "b": "bushing",
      "gap": {
        "min": 0.05,
        "max": 1
      },
      "expect": {
        "eq": 1
      },
      "from": "a running clearance of at least 0.05 mm"
    }
  ]
}
