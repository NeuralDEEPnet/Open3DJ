{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:open3dj:v0:agent-event",
  "title": "One event of the agent panel",
  "description": "open3dj view sends these on its api/events stream as the agent event (RFC 0001). Every event has a sequence number for replay, a time and, inside a turn, the turn id; the rest depends on kind. Text is shown as plain text only.",
  "oneOf": [
    {
      "description": "The panel's state, with the engine and model of a waiting or running prompt.",
      "type": "object",
      "properties": {
        "seq": { "$ref": "#/$defs/seq" },
        "ts": { "$ref": "#/$defs/ts" },
        "turn": { "$ref": "#/$defs/turn" },
        "kind": { "const": "status" },
        "state": { "enum": ["idle", "awaiting_approval", "running", "stopping"] },
        "engine": { "$ref": "#/$defs/engine" },
        "model": { "$ref": "#/$defs/modelId" }
      },
      "required": ["seq", "ts", "kind", "state"],
      "additionalProperties": false
    },
    {
      "description": "What the person sent, once it was approved.",
      "type": "object",
      "properties": {
        "seq": { "$ref": "#/$defs/seq" },
        "ts": { "$ref": "#/$defs/ts" },
        "turn": { "$ref": "#/$defs/turn" },
        "kind": { "const": "prompt" },
        "text": { "type": "string", "minLength": 1, "maxLength": 32000 }
      },
      "required": ["seq", "ts", "kind", "text"],
      "additionalProperties": false
    },
    {
      "description": "A piece of the model's reply as it streams.",
      "type": "object",
      "properties": {
        "seq": { "$ref": "#/$defs/seq" },
        "ts": { "$ref": "#/$defs/ts" },
        "turn": { "$ref": "#/$defs/turn" },
        "kind": { "const": "text" },
        "delta": { "type": "string", "maxLength": 1048576 }
      },
      "required": ["seq", "ts", "kind", "delta"],
      "additionalProperties": false
    },
    {
      "description": "Drop what the current reply showed so far: it was stopped or failed and never joined the conversation.",
      "type": "object",
      "properties": {
        "seq": { "$ref": "#/$defs/seq" },
        "ts": { "$ref": "#/$defs/ts" },
        "turn": { "$ref": "#/$defs/turn" },
        "kind": { "const": "discard" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 200 }
      },
      "required": ["seq", "ts", "kind", "reason"],
      "additionalProperties": false
    },
    {
      "description": "A tool step the model asked for, with an input preview of at most 32 KiB.",
      "type": "object",
      "properties": {
        "seq": { "$ref": "#/$defs/seq" },
        "ts": { "$ref": "#/$defs/ts" },
        "turn": { "$ref": "#/$defs/turn" },
        "kind": { "const": "tool_call" },
        "call": { "$ref": "#/$defs/callId" },
        "tool": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$" },
        "input_preview": { "type": "string", "maxLength": 32768 },
        "input_bytes": { "type": "integer", "minimum": 0 }
      },
      "required": ["seq", "ts", "kind", "call", "tool", "input_preview", "input_bytes"],
      "additionalProperties": false
    },
    {
      "description": "How a tool step ended, in one line.",
      "type": "object",
      "properties": {
        "seq": { "$ref": "#/$defs/seq" },
        "ts": { "$ref": "#/$defs/ts" },
        "turn": { "$ref": "#/$defs/turn" },
        "kind": { "const": "tool_result" },
        "call": { "$ref": "#/$defs/callId" },
        "status": { "enum": ["ok", "warning", "error", "queued"] },
        "rev": { "$ref": "urn:open3dj:v0:common#/$defs/rev" },
        "code": { "$ref": "urn:open3dj:v0:common#/$defs/errorCode" },
        "summary": { "type": "string", "maxLength": 300 }
      },
      "required": ["seq", "ts", "kind", "call", "status", "summary"],
      "additionalProperties": false
    },
    {
      "description": "Tokens of one request, the session so far, and what the budget has left.",
      "type": "object",
      "properties": {
        "seq": { "$ref": "#/$defs/seq" },
        "ts": { "$ref": "#/$defs/ts" },
        "turn": { "$ref": "#/$defs/turn" },
        "kind": { "const": "usage" },
        "request": { "$ref": "#/$defs/usage" },
        "session": { "$ref": "#/$defs/usage" },
        "remaining": { "$ref": "#/$defs/budget" }
      },
      "required": ["seq", "ts", "kind", "request", "session", "remaining"],
      "additionalProperties": false
    },
    {
      "description": "A line for the person: a retry, a filled-in base_rev, a refusal, a limit.",
      "type": "object",
      "properties": {
        "seq": { "$ref": "#/$defs/seq" },
        "ts": { "$ref": "#/$defs/ts" },
        "turn": { "$ref": "#/$defs/turn" },
        "kind": { "const": "notice" },
        "level": { "enum": ["info", "warn", "error"] },
        "text": { "type": "string", "minLength": 1, "maxLength": 2000 }
      },
      "required": ["seq", "ts", "kind", "level", "text"],
      "additionalProperties": false
    },
    {
      "description": "How the turn ended. context_window: the conversation filled the model's context window, so only a new conversation goes on.",
      "type": "object",
      "properties": {
        "seq": { "$ref": "#/$defs/seq" },
        "ts": { "$ref": "#/$defs/ts" },
        "turn": { "$ref": "#/$defs/turn" },
        "kind": { "const": "turn_end" },
        "reason": { "enum": ["end_turn", "max_rounds", "max_tokens", "context_window", "refusal", "stopped", "budget", "timeout", "error"] },
        "message": { "type": "string", "maxLength": 2000 }
      },
      "required": ["seq", "ts", "kind", "reason"],
      "additionalProperties": false
    },
    {
      "description": "An approval card. Nothing leaves the machine until the person approves it with its payload hash.",
      "type": "object",
      "properties": {
        "seq": { "$ref": "#/$defs/seq" },
        "ts": { "$ref": "#/$defs/ts" },
        "turn": { "$ref": "#/$defs/turn" },
        "kind": { "const": "approval" },
        "id": { "$ref": "#/$defs/approvalId" },
        "payload": { "$ref": "#/$defs/payload" },
        "payload_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "expires_at": { "$ref": "#/$defs/ts" },
        "scopes": { "type": "array", "items": { "$ref": "#/$defs/scope" }, "minItems": 1, "maxItems": 2 }
      },
      "required": ["seq", "ts", "kind", "id", "payload", "payload_hash", "expires_at", "scopes"],
      "additionalProperties": false
    },
    {
      "description": "A card's final answer.",
      "type": "object",
      "properties": {
        "seq": { "$ref": "#/$defs/seq" },
        "ts": { "$ref": "#/$defs/ts" },
        "turn": { "$ref": "#/$defs/turn" },
        "kind": { "const": "approval_result" },
        "id": { "$ref": "#/$defs/approvalId" },
        "decision": { "enum": ["approved", "denied", "expired"] },
        "scope": { "$ref": "#/$defs/scope" },
        "by": { "type": "string", "pattern": "^(computer|expiry|device:[A-Za-z0-9_-]{1,64})$" }
      },
      "required": ["seq", "ts", "kind", "id", "decision", "by"],
      "additionalProperties": false
    },
    {
      "description": "The conversation was cleared.",
      "type": "object",
      "properties": { "seq": { "$ref": "#/$defs/seq" }, "ts": { "$ref": "#/$defs/ts" }, "turn": { "$ref": "#/$defs/turn" }, "kind": { "const": "reset" } },
      "required": ["seq", "ts", "kind"],
      "additionalProperties": false
    },
    {
      "description": "The page missed events the server no longer holds: load the snapshot again.",
      "type": "object",
      "properties": { "seq": { "$ref": "#/$defs/seq" }, "ts": { "$ref": "#/$defs/ts" }, "turn": { "$ref": "#/$defs/turn" }, "kind": { "const": "resync" } },
      "required": ["seq", "ts", "kind"],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "seq": { "type": "integer", "minimum": 1 },
    "ts": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$" },
    "turn": { "type": "string", "pattern": "^t_[0-9]{4,9}$" },
    "engine": { "enum": ["api", "cli"] },
    "modelId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]{0,127}$" },
    "callId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$" },
    "approvalId": { "type": "string", "pattern": "^a_[0-9a-f]{16}$" },
    "scope": { "enum": ["prompt", "session"] },
    "usage": {
      "type": "object",
      "properties": {
        "input": { "type": "integer", "minimum": 0 },
        "output": { "type": "integer", "minimum": 0 },
        "cache_read": { "type": "integer", "minimum": 0 },
        "cache_write": { "type": "integer", "minimum": 0 }
      },
      "required": ["input", "output", "cache_read", "cache_write"],
      "additionalProperties": false
    },
    "budget": {
      "type": "object",
      "properties": { "input": { "type": "integer", "minimum": 0 }, "output": { "type": "integer", "minimum": 0 } },
      "required": ["input", "output"],
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "properties": {
        "maxRounds": { "type": "integer", "minimum": 1 },
        "maxOutputTokens": { "type": "integer", "minimum": 1 },
        "timeoutMs": { "type": "integer", "minimum": 1 }
      },
      "required": ["maxRounds", "maxOutputTokens", "timeoutMs"],
      "additionalProperties": false
    },
    "payload": {
      "description": "What the card shows: who pays, where it goes, what is sent and the limits.",
      "type": "object",
      "properties": {
        "engine": { "$ref": "#/$defs/engine" },
        "billing": { "type": "string", "minLength": 1, "maxLength": 200 },
        "host": { "type": "string", "pattern": "^[A-Za-z0-9 .:\\[\\]-]{1,255}$" },
        "model": { "anyOf": [{ "$ref": "#/$defs/modelId" }, { "type": "null" }] },
        "project": { "type": "string", "minLength": 1, "maxLength": 255 },
        "prompt": { "type": "string", "minLength": 1, "maxLength": 32000 },
        "conversation": {
          "type": "object",
          "properties": { "messages": { "type": "integer", "minimum": 0 }, "bytes": { "type": "integer", "minimum": 0 } },
          "required": ["messages", "bytes"],
          "additionalProperties": false
        },
        "instructions": {
          "type": "object",
          "properties": {
            "tools": { "type": "integer", "minimum": 0 },
            "bytes": { "type": "integer", "minimum": 0 },
            "hash": { "type": "string", "pattern": "^[0-9a-f]{16}$" }
          },
          "required": ["tools", "bytes", "hash"],
          "additionalProperties": false
        },
        "limits": { "$ref": "#/$defs/limits" },
        "budget": { "$ref": "#/$defs/budget" },
        "estimate": {
          "type": "object",
          "properties": { "input_tokens": { "type": "integer", "minimum": 0 }, "basis": { "const": "bytes / 4, an estimate" } },
          "required": ["input_tokens", "basis"],
          "additionalProperties": false
        }
      },
      "required": ["engine", "billing", "host", "model", "project", "prompt", "conversation", "instructions", "limits", "budget", "estimate"],
      "additionalProperties": false
    }
  }
}
