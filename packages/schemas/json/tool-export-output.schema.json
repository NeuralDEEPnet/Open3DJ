{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:open3dj:v0:tool-export-output",
  "title": "export tool output (S1)",
  "type": "object",
  "properties": {
    "status": { "enum": ["ok", "error"] },
    "rev": { "$ref": "urn:open3dj:v0:common#/$defs/rev" },
    "files": { "type": "array", "items": { "$ref": "urn:open3dj:v0:common#/$defs/fileRef" } },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "error": { "$ref": "urn:open3dj:v0:script-error" },
    "compute": { "$ref": "urn:open3dj:v0:compute" }
  },
  "required": ["status", "compute"],
  "additionalProperties": false
}
