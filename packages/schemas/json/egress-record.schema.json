{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:open3dj:v0:egress-record",
  "title": "One line of the agent panel's egress log",
  "description": "open3dj view appends one record per approval decision and one per request that left the machine (RFC 0001) to an owner-only JSON Lines file. A record names the card by its id and payload hash; it never holds the prompt text, the conversation or any key.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "ts": { "$ref": "#/$defs/ts" },
        "kind": { "const": "approval" },
        "approval_id": { "$ref": "#/$defs/approvalId" },
        "payload_hash": { "$ref": "#/$defs/sha256" },
        "engine": { "$ref": "#/$defs/engine" },
        "host": { "$ref": "#/$defs/host" },
        "model": { "$ref": "#/$defs/model" },
        "decision": { "enum": ["approved", "denied", "expired"] },
        "scope": { "enum": ["prompt", "session"] },
        "by": { "$ref": "#/$defs/by" },
        "grant": { "description": "The session approval that covered this prompt without a card.", "$ref": "#/$defs/approvalId" }
      },
      "required": ["ts", "kind", "approval_id", "payload_hash", "engine", "host", "model", "decision", "by"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "ts": { "$ref": "#/$defs/ts" },
        "kind": { "const": "request" },
        "approval_id": { "$ref": "#/$defs/approvalId" },
        "payload_hash": { "$ref": "#/$defs/sha256" },
        "engine": { "$ref": "#/$defs/engine" },
        "host": { "$ref": "#/$defs/host" },
        "model": { "$ref": "#/$defs/model" },
        "request_bytes": { "type": "integer", "minimum": 0 },
        "attempts": { "type": "integer", "minimum": 1, "maximum": 10 },
        "usage": { "anyOf": [{ "$ref": "#/$defs/usage" }, { "type": "null" }] },
        "outcome": { "enum": ["ok", "error", "stopped", "timeout"] }
      },
      "required": ["ts", "kind", "approval_id", "payload_hash", "engine", "host", "model", "request_bytes", "attempts", "usage", "outcome"],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "ts": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$" },
    "approvalId": { "type": "string", "pattern": "^a_[0-9a-f]{16}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "engine": { "enum": ["api", "cli"] },
    "host": { "description": "Where requests went: a host name, or \"through Claude Code\".", "type": "string", "pattern": "^[A-Za-z0-9 .:\\[\\]-]{1,255}$" },
    "model": { "description": "A model id from the API's list, or null when the engine names it only once it starts.", "anyOf": [{ "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]{0,127}$" }, { "type": "null" }] },
    "by": { "description": "Who decided: this computer's page, a paired device, or the clock for an expired card.", "type": "string", "pattern": "^(computer|expiry|device:[A-Za-z0-9_-]{1,64})$" },
    "usage": {
      "type": "object",
      "properties": {
        "input": { "type": "integer", "minimum": 0 },
        "output": { "type": "integer", "minimum": 0 },
        "cache_read": { "type": "integer", "minimum": 0 },
        "cache_write": { "type": "integer", "minimum": 0 }
      },
      "required": ["input", "output", "cache_read", "cache_write"],
      "additionalProperties": false
    }
  }
}
