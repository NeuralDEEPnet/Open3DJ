{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:open3dj:v0:tool-run-input",
  "title": "run tool input",
  "description": "Run a DSL script or apply ops, and get a GeometryReport. Give script, ops, or both.",
  "type": "object",
  "properties": {
    "project": {
      "description": "Project folder (.o3j). Created on the first run with a script.",
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "base_rev": {
      "description": "The revision this change builds on. A stale base_rev is refused.",
      "$ref": "urn:open3dj:v0:common#/$defs/rev"
    },
    "script": {
      "description": "DSL source (JavaScript, 3dj dialect).",
      "type": "string",
      "minLength": 1,
      "maxLength": 262144
    },
    "params": {
      "description": "Values for Param.* entries, by name, saved to the project's params.o3j.json (clamped to each Param's min and max) unless save_params is false: later runs of the same script, and set_param, use them. A script that differs from the stored one starts from its own defaults plus these values, and the report names the stored values it did not use.",
      "type": "object",
      "maxProperties": 200,
      "propertyNames": {
        "minLength": 1,
        "maxLength": 100
      },
      "additionalProperties": {
        "type": [
          "number",
          "string",
          "boolean"
        ],
        "maxLength": 4096
      }
    },
    "save_params": {
      "description": "false runs with params and set_param values and records them in the new revision, but keeps params.o3j.json as it was. Default true.",
      "type": "boolean"
    },
    "ops": {
      "description": "set_param, cancel_job and waive. Assembly edits such as add_occurrence arrive in S2; change the script instead.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/op"
      },
      "maxItems": 500
    },
    "compute": {
      "$ref": "urn:open3dj:v0:common#/$defs/computeMode"
    },
    "detail": {
      "enum": [
        "concise",
        "detailed"
      ]
    }
  },
  "required": [
    "project"
  ],
  "anyOf": [
    {
      "required": [
        "script"
      ]
    },
    {
      "required": [
        "ops"
      ]
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "op": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "set_param"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "value": {
              "type": [
                "number",
                "string",
                "boolean"
              ],
              "maxLength": 4096
            }
          },
          "required": [
            "op",
            "name",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "cancel_job"
            },
            "job_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          },
          "required": [
            "op",
            "job_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "waive"
            },
            "gate": {
              "enum": [
                "min_wall",
                "overhang",
                "watertight",
                "bed"
              ]
            },
            "target": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "build": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            }
          },
          "required": [
            "op",
            "gate",
            "target",
            "reason"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
