{
  "$schema": "../../../packages/schemas/json/bench-task.schema.json",
  "id": "reg-phone-stand",
  "version": 1,
  "split": "regression",
  "title": "Phone stand",
  "brief": "A desk phone stand 70 mm wide: a side profile with a base plate, a front lip, a phone ledge and a backrest leaning back, extruded to width, with a cable slot through the base, a 12 mm notch in the lip and 1.5 mm fillets on the long edges. One part.",
  "params": {},
  "assertions": [
    {
      "id": "status",
      "kind": "status",
      "in": [
        "ok"
      ]
    },
    {
      "id": "valid",
      "kind": "valid"
    },
    {
      "id": "size-x",
      "kind": "measure",
      "quantity": "size_x",
      "target": "assembly",
      "expect": {
        "eq": 70,
        "tol": {
          "abs": 0.0001
        }
      }
    },
    {
      "id": "size-y",
      "kind": "measure",
      "quantity": "size_y",
      "target": "assembly",
      "expect": {
        "eq": 95,
        "tol": {
          "abs": 0.0001
        }
      }
    },
    {
      "id": "size-z",
      "kind": "measure",
      "quantity": "size_z",
      "target": "assembly",
      "expect": {
        "eq": 80.522705,
        "tol": {
          "abs": 0.0001
        }
      }
    },
    {
      "id": "volume",
      "kind": "measure",
      "quantity": "volume_mm3",
      "target": "phone_stand",
      "expect": {
        "eq": 92790.939889,
        "tol": {
          "rel": 0.0001
        }
      }
    },
    {
      "id": "faces",
      "kind": "count",
      "quantity": "faces",
      "target": "phone_stand",
      "expect": {
        "eq": 32
      }
    }
  ],
  "reference": "reference.o3j.js",
  "mutant": "mutant.o3j.js",
  "mutant_defect": "The notch in the front lip is missing.",
  "mutant_fails": [
    "volume",
    "faces"
  ],
  "tags": [
    "single-part",
    "polygon",
    "fillet"
  ],
  "source": "examples/phone-stand",
  "licence": "MIT",
  "authors": [
    "neuraldeep.net design agents"
  ]
}
