{
  "name": "open3dj-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Open3DJ: open-source, agent-first, local-first CAD. Monorepo root.",
  "license": "MIT",
  "author": "Neural Deep Network LTD and the Open3DJ contributors",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "node scripts/check.ts",
    "typecheck": "tsc -p tsconfig.json",
